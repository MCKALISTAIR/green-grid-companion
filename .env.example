# =========================================================================
# Supabase Edge Functions Production Environment Secrets (Set in Dashboard)
# =========================================================================

# APNs Configuration (for direct iOS push notifications)
# APNS_PRIVATE_KEY is the multi-line PEM/PKCS8 private key from your Apple developer portal (.p8 file)
APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_DATA\n-----END PRIVATE KEY-----"
APNS_KEY_ID="your-10-character-key-id"
APNS_TEAM_ID="your-10-character-team-id"
APNS_BUNDLE_ID="your-app-bundle-id"
APNS_USE_SANDBOX="false" # set to "true" for Sandbox/Development APNs environment

# FCM Configuration (for Android/Web/iOS push notifications)
# FCM_PRIVATE_KEY is the multi-line PEM private key from your Firebase Service Account JSON
FCM_PROJECT_ID="your-firebase-project-id"
FCM_CLIENT_EMAIL="your-firebase-service-account-email"
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_DATA\n-----END PRIVATE KEY-----"
